{
  "info": {
    "name": "Sales Order DDD API",
    "description": "Sales Order Processing API — DDD + Hexagonal + CQRS. Use the variables `baseUrl`, `customerId`, `productId1`, `productId2`, `saleId` in the collection.",
    "version": "1.1.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",     "value": "http://localhost:8000/api" },
    { "key": "customerId",  "value": "01ARZ3NDEKTSV4RRFFQ69G5FAV" },
    { "key": "productId1",  "value": "01ARZ3NDEKTSV4RRFFQ69G5FAW" },
    { "key": "productId2",  "value": "01ARZ3NDEKTSV4RRFFQ69G5FAX" },
    { "key": "saleId",      "value": "01ARZ3NDEKTSV4RRFFQ69G5FAY" }
  ],
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PT Maju Jaya\",\n  \"email\": \"contact@majujaya.com\",\n  \"phone\": \"021-555-1234\"\n}"
            },
            "description": "Create a customer. Copy the returned `id` into the `customerId` variable."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Dell XPS 15\",\n  \"sku\": \"DEL-XPS15-2024\",\n  \"price\": 15000000,\n  \"currency\": \"IDR\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Sales - Commands (write side)",
      "description": "CQRS command endpoints — return `void`, only status messages.",
      "item": [
        {
          "name": "Create Sale (→ PENDING)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/sales", "host": ["{{baseUrl}}"], "path": ["sales"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customerId}}\",\n  \"line_items\": [\n    { \"product_id\": \"{{productId1}}\", \"quantity\": 1 },\n    { \"product_id\": \"{{productId2}}\", \"quantity\": 5 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Confirm Sale (→ CONFIRMED)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/sales/{{saleId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "{{saleId}}", "confirm"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_method\": \"credit_card\"\n}"
            },
            "description": "PaymentMethod enum: credit_card | bank_transfer | e_wallet | cash. Invalid values return 422."
          }
        },
        {
          "name": "Complete Sale (→ COMPLETED)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/sales/{{saleId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "{{saleId}}", "complete"]
            },
            "body": { "mode": "raw", "raw": "{}" },
            "description": "Handler invokes CommissionCalculatorInterface; 5% > 1.000.000 else 3%."
          }
        },
        {
          "name": "Cancel Sale (→ CANCELLED)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/sales/{{saleId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "{{saleId}}", "cancel"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Customer requested cancellation\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Sales - Queries (read side)",
      "description": "CQRS query endpoints — return flat read models (SaleDetailRM, SaleListItemRM).",
      "item": [
        {
          "name": "Get Sale Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sales/{{saleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "{{saleId}}"]
            }
          }
        },
        {
          "name": "List Sales (no filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sales",
              "host": ["{{baseUrl}}"],
              "path": ["sales"]
            }
          }
        },
        {
          "name": "List Sales (filter: customer + status + pagination)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sales?customer_id={{customerId}}&status=confirmed&limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["sales"],
              "query": [
                { "key": "customer_id", "value": "{{customerId}}" },
                { "key": "status",      "value": "confirmed" },
                { "key": "limit",       "value": "10" },
                { "key": "offset",      "value": "0" }
              ]
            }
          }
        },
        {
          "name": "List Sales (filter: date range)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sales?date_from=2026-08-01 00:00:00&date_to=2026-08-31 23:59:59",
              "host": ["{{baseUrl}}"],
              "path": ["sales"],
              "query": [
                { "key": "date_from", "value": "2026-08-01 00:00:00" },
                { "key": "date_to",   "value": "2026-08-31 23:59:59" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sales - Reports (aggregated)",
      "description": "Per-day aggregated read models. Only COMPLETED sales are counted.",
      "item": [
        {
          "name": "Daily Sales Report",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sales/reports/sales?from=2026-08-01 00:00:00&to=2026-08-31 23:59:59",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "reports", "sales"],
              "query": [
                { "key": "from", "value": "2026-08-01 00:00:00" },
                { "key": "to",   "value": "2026-08-31 23:59:59" }
              ]
            }
          }
        },
        {
          "name": "Daily Commission Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sales/reports/commissions?from=2026-08-01 00:00:00&to=2026-08-31 23:59:59",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "reports", "commissions"],
              "query": [
                { "key": "from", "value": "2026-08-01 00:00:00" },
                { "key": "to",   "value": "2026-08-31 23:59:59" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Error scenarios",
      "description": "Handy requests to exercise the exception handlers in bootstrap/app.php.",
      "item": [
        {
          "name": "422 — invalid payment_method",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/sales/{{saleId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "{{saleId}}", "confirm"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"payment_method\": \"bitcoin\"\n}" }
          }
        },
        {
          "name": "422 — missing payment_method",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/sales/{{saleId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "{{saleId}}", "confirm"]
            },
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "404 — sale not found",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sales/00000000000000000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "00000000000000000000000000"]
            }
          }
        }
      ]
    }
  ]
}
